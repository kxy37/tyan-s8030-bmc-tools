# fanctl 配置文件
#
# 路径：/etc/fanctl.conf
# 说明：本文件**可选**。不创建时全部使用程序内置默认值（适用于 TYAN S8030 系列）。
#       只有当你的主板型号不同、或想调整曲线时才需要它。
#
# 格式：key = value    （# 之后为注释）
#
# 修改后验证：
#   sudo fanctl.py --show-config      # 只打印配置，不动作
#   sudo fanctl.py --dry-run --once   # 演练一轮，不下发
#   sudo systemctl restart fanctl     # 生效

# --- 风扇通道号 -----------------------------------------------------------
# OEM 命令 `raw 0x2e 0x44 0xfd 0x19 0x00 <通道号> 0x01 <占空比>` 里的通道号。
# TYAN S8030 系列：0x00 = CPU_FAN
# 其它主板需要自己扫描确定（社区脚本中 S8030-2T 的参考值为
# 0x00=cpu, 0x02=机箱, 0x03=硬盘, 0x04=PCIE，但**不同型号不一定相同**）。
fan_idx = 0x00

# --- 温度传感器编号 -------------------------------------------------------
# 对应 `ipmitool raw 0x04 0x2d <编号>`。
# TYAN S8030 系列：0x01 = CPU_Tctl_Value
# 查看你板子上的传感器编号：sudo ipmitool sdr elist | grep -i cpu
temp_sensor = 0x01

# --- 温度曲线 -------------------------------------------------------------
# 格式：逗号分隔的 "温度°C:占空比%" 对，程序在点之间做线性插值。
# 默认曲线（对应 S8030 出厂 30% 这一下限）：
#     ≤45°C -> 30%（= 出厂值，不会更慢）
#      55°C -> 40%
#      65°C -> 55%
#      75°C -> 78%
#     ≥85°C -> 100%
curve = 45:30, 55:40, 65:55, 75:78, 85:100

# --- 占空比下限 / 上限 ----------------------------------------------------
# 建议 min_duty 设成你这块板的**出厂默认占空比**，这样最坏情况也不会比原厂更热。
# S8030 出厂为 30%。
min_duty = 30
max_duty = 100

# --- 保底占空比 -----------------------------------------------------------
# 读不到温度、程序异常、被 systemctl stop 时，会切到这个值。
failsafe_duty = 60

# --- 采样周期（秒）--------------------------------------------------------
interval = 10

# --- 每周期最大变化量（%）-------------------------------------------------
# 避免转速突变发出"呼呼"声。
max_step = 15

# --- 死区（%）-------------------------------------------------------------
# 目标占空比变化小于该值时不动作，防止在曲线拐点附近来回抖动。
deadband = 2
