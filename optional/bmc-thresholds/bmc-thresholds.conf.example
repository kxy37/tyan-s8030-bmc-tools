# bmc-thresholds 配置文件
#
# 路径：/etc/bmc-thresholds.conf
# 格式（每行一条，# 之后为注释）：
#     <传感器名> <传感器编号(16进制)> <目标上限°C>
#
# 改完验证：
#   sudo bmc-thresholds.sh                      # 立即应用/检查一次
#   sudo ipmitool sensor get <名> | grep -i "Upper critical"   # 看实际生效值
#   sudo journalctl -u bmc-thresholds -n 20     # 看日志
#
# 撤销（恢复出厂）：
#   把下面这行的值改回出厂值，或直接删掉该行，然后重跑一次
#   （删掉后定时器不会再去改它，但 BMC 里当前值仍是改过的 —— 需要手动改回）

# ---------------------------------------------------------------------------
# TYAN S8030 系列：主板进风温度误报
# ---------------------------------------------------------------------------
# 背景：MB_Air_Inlet 出厂上限 50°C、标称 32°C。手册定义它是
#       "Temperature of the M/B Air Inlet Area"，位置在主板下边缘、
#       紧贴 SYS_FAN2/FAN3 插座旁。
#       装了 GeForce/Quadro 显卡后，显卡尾气会直接吹到它身上，
#       于是它测到的其实是显卡尾气温度，很容易撞 50°C 触发蜂鸣器长鸣。
#
# 为什么敢调高：实测这块传感器读数（45~50°C）比"出风"传感器（43~47°C）还高，
#       物理上倒挂 —— 说明它已经不在测进风了。同时其余所有温度传感器都有充裕
#       余量（CPU 49°C、内存区 39~48°C、供电 MOSFET 64~72°C、出风 28°C），
#       所以只调这一颗不影响整机保护（CPU 95 / 内存 85 / MOSFET 110 / 出风 70
#       四道独立防线都不动）。
#
# 出厂值：50    建议值：75
MB_Air_Inlet 0x32 75

# ---------------------------------------------------------------------------
# 想加更多传感器，照上面格式追加即可。例如：
#
#   SYS_Air_Inlet    0x30 55      # 前面板外接进风传感器（未装则为"无读数"）
#   SYS_Air_Outlet   0x31 75      # 系统出风温度
#
# 传感器编号查法：
#   sudo ipmitool sdr elist          # 第一列是名字，第二列是编号（如 32h）
#   sudo ipmitool sdr get <名>       # 看 "Sensor ID : xxx (0x32)"
# ---------------------------------------------------------------------------
